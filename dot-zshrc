export PATH=$HOME/.volta/bin:$HOME/.cargo/bin:$PATH
# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"
export WORK="$HOME/work"

# Set name of the theme to load --- if set to "random", it will
ZSH_THEME="robbyrussell"

plugins=(
  git
  vi-mode
)

source $ZSH/oh-my-zsh.sh
source $WORK/alias.zsh

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

# Compilation flags
# export ARCHFLAGS="-arch $(uname -m)"

alias s="source ~/.zshrc"
alias cr="cargo run"
alias ct="cargo test"
alias cck="cargo check"
alias vi="nvim"
alias vim="nvim"
alias ll="ls -l"
alias la="ls -la"
alias sess="~/bin/tmux-sessionizer"
alias ssh-picker="~/bin/ssh-picker"
#alias snvm="source /usr/share/nvm/init-nvm.sh"

function record { wf-recorder -g "$(slurp)" -f "${2:-$HOME/recording}.mkv" }
function recording-to-mp4 { ffmpeg -i "${1:-$HOME/recording}.mkv" -codec copy  "${2:-$HOME/recording}.mp4" }

if [[ -z "${SSH_CONNECTION}" ]]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi

bindkey -M viins 'jk' vi-cmd-mode
source <(fzf --zsh)

