export PATH="/opt/stripe/bin:$HOME/.local/bin:$HOME/.volta/bin:$HOME/.cargo/bin:$PATH"

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"
export WORK="$HOME/work"
export DIRENV_LOG_FORMAT=""
export AWS_PAGER=""

# Set name of the theme to load --- if set to "random", it will
ZSH_THEME="robbyrussell"

plugins=(
  git
  vi-mode
)

source $ZSH/oh-my-zsh.sh
source $WORK/alias.zsh

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

# Compilation flags
# export ARCHFLAGS="-arch $(uname -m)"

alias s="source ~/.zshrc"
alias cr="cargo run"
alias ct="cargo test"
alias cck="cargo check"
alias vi="nvim"
alias vim="nvim"
alias ll="ls -l"
alias la="ls -la"
alias sess="~/bin/tmux-sessionizer"
alias ssh-picker="~/bin/ssh-picker"
alias hyp="start-hyprland"
alias hypr="start-hyprland"
alias fman='man -k . | fzf --prompt="Man> " \
  --preview="echo {} | sed \"s/^\([^ ]*\) (\([^)]*\)).*/man \2 \1/\" | sh" \
  --bind="enter:execute(echo {} | sed \"s/^\([^ ]*\) (\([^)]*\)).*/man \2 \1/\" | sh)+abort"
  '

function record { wf-recorder -g "$(slurp)" -f "${2:-$HOME/recording}.mkv" }
function recording-to-mp4 { ffmpeg -i "${1:-$HOME/recording}.mkv" -codec copy  "${2:-$HOME/recording}.mp4" }
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

if [[ -z "${SSH_CONNECTION}" ]]; then
  export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi


bindkey -M viins 'jk' vi-cmd-mode

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M viins '^X^E' edit-command-line
bindkey -M vicmd '^X^E' edit-command-line

source <(fzf --zsh)
eval "$(zoxide init zsh)"

autoload -U compinit; compinit

eval "$(direnv hook bash)"

source /opt/google-cloud-cli/path.zsh.inc
source /opt/google-cloud-cli/completion.zsh.inc

load_env() {
  set -a
  source "${1:-.env}"
  set +a
}
